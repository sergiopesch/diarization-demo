{
  "name": "diarization-demo",
  "private": true,
  "version": "1.0.0",
  "description": "Browser-based speaker diarization demo with pluggable cloud and local backends.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run src/lib",
    "test:e2e": "NO_COLOR= playwright test",
    "audit": "npm audit --audit-level=high",
    "verify": "npm run lint && npm run test && npm run typecheck && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@google-cloud/speech": "^7.5.0",
    "next": "^16.2.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "postcss": "^8.5.19",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "brace-expansion": "file:vendor/brace-expansion-compat"
  },
  "overrides": {
    "@babel/core": "^7.29.7",
    "@grpc/grpc-js": "^1.14.4",
    "brace-expansion@^5": "^5.0.8",
    "js-yaml": "^4.3.0",
    "protobufjs": "^7.6.5",
    "glob": "^13.0.6",
    "postcss": "$postcss",
    "uuid": "^14.0.0",
    "minimatch@3.1.5": {
      "brace-expansion": "$brace-expansion"
    },
    "sharp": "0.35.3"
  }
}
